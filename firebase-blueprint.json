{
  "entities": {
    "UserData": {
      "title": "UserData",
      "description": "User configuration, tasks, schedule, and grades",
      "type": "object",
      "properties": {
        "tasks_data": {
          "type": "array",
          "description": "Tasks data array stored as JSON",
          "items": { "type": "object" }
        },
        "schedule_data": {
          "type": "array",
          "description": "Schedule data array stored as JSON",
          "items": { "type": "object" }
        },
        "grades_data": {
          "type": "object",
          "description": "Grades data stored as JSON"
        },
        "updated_at": {
          "type": "object",
          "description": "Firestore server timestamp"
        }
      }
    },
    "Attachment": {
      "title": "Attachment",
      "description": "A single attachment for a task (image, pdf, link)",
      "type": "object",
      "properties": {
        "taskId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "url": { "type": "string" },
        "base64": { "type": "string" }
      }
    }
  },
  "firestore": {
    "user_data/{userId}": {
      "schema": "UserData",
      "description": "User specific data"
    },
    "user_data/{userId}/attachments/{attachmentId}": {
      "schema": "Attachment",
      "description": "Attachments for user tasks"
    }
  }
}
