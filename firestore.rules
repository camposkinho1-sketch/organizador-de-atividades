rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprint for UserData
    function isValidUserData(data) {
      return (
        (!('tasks_data' in data) || data.tasks_data is list) &&
        (!('schedule_data' in data) || data.schedule_data is list) &&
        (!('grades_data' in data) || data.grades_data is map) &&
        (!('api_key_data' in data) || data.api_key_data is string) &&
        (!('updated_at' in data) || data.updated_at is timestamp)
      );
    }

    // Validation Blueprint for Attachment
    function isValidAttachment(data) {
      return (
        ('taskId' in data && data.taskId is string) &&
        ('name' in data && data.name is string) &&
        ('type' in data && data.type is string) &&
        (!('url' in data) || data.url is string) &&
        (!('base64' in data) || data.base64 is string)
      );
    }

    match /user_data/{userId} {
      allow read: if isOwner(userId);
      
      allow create: if isOwner(userId) && isValidUserData(incoming());
      
      allow update: if isOwner(userId) && isValidUserData(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasAny([
          'tasks_data', 'schedule_data', 'grades_data', 'api_key_data', 'updated_at'
        ])
      );
      
      allow delete: if isOwner(userId);

      match /attachments/{attachmentId} {
        allow read: if isOwner(userId);
        
        allow create: if isOwner(userId) && isValidAttachment(incoming());
        
        allow update: if isOwner(userId) && isValidAttachment(incoming()) && (
          incoming().diff(existing()).affectedKeys().hasAny([
            'taskId', 'name', 'type', 'url', 'base64'
          ])
        );
        
        allow delete: if isOwner(userId);
      }
    }
  }
}
